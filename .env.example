# Kopieer naar .env.local en vul in. Alle VITE_-variabelen komen in de browser-bundle terecht:
# zet hier dus nooit geheime sleutels in.

# Absolute URL van de live site (zonder / aan het eind), voor canonical, Open Graph en sitemap.
# Op Vercel mag je dit leeg laten: dan wordt het productiedomein van het project gebruikt.
VITE_SITE_URL=

# Contactformulier via EmailJS (https://www.emailjs.com). Laat leeg om terug te vallen op mailto.
# De public key is bedoeld voor gebruik in de browser. Stel in het EmailJS-dashboard
# "Allowed origins" in op je eigen domein, zodat anderen je quota niet kunnen gebruiken.
# Template-variabelen: {{from_name}}, {{reply_to}}, {{topic}}, {{message}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
